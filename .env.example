# mock | openai-compatible | anthropic
TUTOR_PROVIDER=mock

# Shared aliases. These override provider-specific values when set.
# TUTOR_API_KEY=
# TUTOR_BASE_URL=
# TUTOR_MODEL=
# TUTOR_MAX_TOKENS=1800

# OpenAI-compatible mode.
# Works with OpenAI, Kimi, Mimo, and other /v1/chat/completions compatible gateways.
# TUTOR_PROVIDER=openai-compatible
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
# OPENAI_COMPATIBLE_MODEL=gpt-4o-mini
# OPENAI_COMPATIBLE_MAX_TOKENS=1800

# Optional common aliases for OpenAI-compatible providers.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# KIMI_API_KEY=
# KIMI_BASE_URL=
# KIMI_MODEL=
# MIMO_API_KEY=
# MIMO_BASE_URL=
# MIMO_MODEL=

# Anthropic-compatible mode.
# Uses POST /v1/messages with x-api-key and anthropic-version headers.
# TUTOR_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-sonnet-4-5
# ANTHROPIC_VERSION=2023-06-01
# ANTHROPIC_MAX_TOKENS=1800
